# Copy this file to `.env` and fill in the values for your machine.
#
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the JS bundle at
# build time. That means these are NOT secrets — they ship inside the app and
# anyone can read them. Only put values here that are safe to publish (an API
# host, OAuth *client* ids). Server secrets stay in backend/.env.
#
# Metro caches the values, so after editing .env restart with:  npx expo start -c

# ---------------------------------------------------------------- API
# The Laravel backend. A phone cannot resolve `localhost`, so this must be your
# machine's LAN IP, and the server must be started so it listens on it:
#   php artisan serve --host=0.0.0.0 --port=8001
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.43:8001/api/v1

# ------------------------------------------------------- social sign-in
# Google: the backend verifies an ID token, so these are OAuth *client ids*
# from Google Cloud Console (one per platform). Leave blank to disable the
# button — it will say Google sign-in is not configured rather than fail.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Facebook: the app id from developers.facebook.com. The backend also needs
# FACEBOOK_APP_ID and FACEBOOK_APP_SECRET in backend/.env to verify the token.
EXPO_PUBLIC_FACEBOOK_APP_ID=
