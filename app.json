{
  "expo": {
    "name": "Guftagu",
    "slug": "guftagu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.guftagu",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.guftagu",
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "BLUETOOTH_CONNECT"],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Guftagu needs access to your photos so you can pick a profile picture.",
          "cameraPermission": "Guftagu needs access to your camera so you can take a profile picture."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-status-bar",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Guftagu needs the microphone so you can speak when you take a seat in a voice room.",
          "cameraPermission": "Guftagu needs the camera for video seats in a voice room."
        }
      ],
      "expo-dev-client"
    ],
    "scheme": "guftagu"
  }
}
